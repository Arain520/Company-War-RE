  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u6B22\u8FCE\u52A0\u5165\u4E94\u516C\u53F8\u3002\u4F5C\u4E3A\u65B0\u4EFB\u7BA1\u7406\u5458\uFF0C\u5E0C\u671B\u60A8\u80FD\u591F\u5C3D\u5FEB\u7406\u89E3\u5E02\u573A\u5F00\u62D3\u7684\u672C\u8D28\u2014\u2014\u5B83\u662F\u4E00\u573A\u8D44\u6E90\u3001\u7A7A\u95F4\u4E0E\u610F\u5FD7\u7684\u6301\u7EED\u6218\u4E89\u3002\r\n\r\n\u4E00\u3001\u6838\u5FC3\u804C\u8D23\r\n\u60A8\u5DF2\u7ECF\u88AB\u6388\u6743\u7BA1\u7406\u6211\u53F8Kn-0655\u5730\u533A\u2014\u2014\u8FD9\u7247\u533A\u57DF\u867D\u5C0F\uFF0C\u4F9D\u7136\u662F\u662F\u516C\u53F8\u6743\u529B\u5EF6\u4F38\u7684\u91CD\u8981\u65B9\u5411\uFF0C\u56E0\u800C\u8BF7\u60A8\u5728\u6B64\u8BA4\u771F\u5DE5\u4F5C\uFF0C\u6211\u4EEC\u5C06\u5C3D\u4E00\u5207\u53EF\u80FD\u534F\u52A9\u60A8\u4E3A\u516C\u53F8\u652B\u53D6\u66F4\u591A\u5229\u76CA\u3002\u5728\u8FD9\u65B9\u9762\uFF0C\u60A8\u7684\u804C\u8D23\u800C\u662F\u901A\u8FC7\u7ECF\u8425\u4E0E\u90E8\u7F72\uFF0C\u6E05\u9664Kn-0655\u5730\u533A\u7684\u6240\u6709\u201C\u7ADE\u4E89\u6027\u8D44\u4EA7\u201D\uFF0C\u6700\u7EC8\u5BF9\u76EE\u6807\u5B9E\u73B0\u201C\u6E05\u7B97\u201D\uFF0C\u6211\u4EEC\u8FD8\u5C06\u5BF9\u60A8\u7684\u6770\u51FA\u8868\u73B0\u8FDB\u884C\u201C\u6388\u52CB\u201D\u3002\r\n\r\n\u4E8C\u3001\u8D44\u4EA7\u8C03\u914D\r\n\u53D7\u6700\u8FD1\u5E02\u573A\u51B2\u51FB\u5F71\u54CD\uFF0C\u6211\u4EEC\u6700\u521D\u53EA\u80FD\u7ED9\u6BCF\u4F4D\u7BA1\u7406\u5458\u63D0\u4F9B10\u5355\u4F4D\u7269\u8D44\uFF0C\u6B64\u540E\u6BCF\u9694\u4E00\u6BB5\u65F6\u95F4\u56FA\u5B9A\u6295\u653E1\u5355\u4F4D\u7269\u8D44\u3002\u6240\u6709\u6211\u65B9\u5355\u4F4D\u5747\u9700\u6D88\u8017\u7269\u8D44\u5728\u5B9E\u63A7\u533A\u5185\u90E8\u7F72\uFF0C\u4E14\u8FDE\u7EED\u90E8\u7F72\u9700\u8981\u4E00\u5B9A\u65F6\u95F4\u51B7\u5374\u3002\r\n\u4EE5\u4E0B\u662F\u60A8\u9700\u8981\u8C28\u8BB0\u7684\u4E3B\u8981\u540D\u8BCD\u2014\u2014\r\n\r\n\xB7
    \u804C\u5458\uFF1A\u57FA\u7840\u6267\u884C\u5355\u5143\uFF0C\u5177\u5907\u653B\u51FB\u529B\u4E0E\u8010\u4E45\uFF0C\u662F\u63A8\u8FDB\u6218\u7EBF\u7684\u6838\u5FC3\u3002\r\n\xB7
    \u5EFA\u7B51\uFF1A\u63D0\u4F9B\u7269\u8D44\u4EA7\u51FA\u3001\u6388\u6743\u79EF\u5206\u6216\u7279\u6B8A\u652F\u63F4\u3002\r\n\xB7
    \u652F\u63F4\uFF1A\u63D0\u4F9B\u4E00\u6B21\u6027\u6253\u51FB\u3001\u5168\u573A\u63A7\u5236\u6216\u9635\u5730\u6784\u5EFA\u7B49\u5173\u952E\u80FD\u529B\u3002\r\n 
    \u90E8\u7F72\u5217\u8868\u4E0A\u9650\u4E3A12\u4E2A\uFF0C\u8C28\u614E\u9009\u62E9\u4F60\u7684\u9635\u5BB9\u7EC4\u5408\u3002\r\n\r\n\u4E09\u3001\u5A01\u80C1\u5E94\u5BF9\r\n\u7ADE\u4E89\u5BF9\u624B\u7684\u201C\u804C\u5458\u201D\u4F1A\u4ECE\u5730\u56FE\u8FDC\u7AEF\u5165\u4FB5\u70B9\u6301\u7EED\u751F\u6210\uFF0C\u5411\u6211\u65B9\u533A\u57DF\u79FB\u52A8\u3002\u4E00\u65E6\u63A5\u89E6\u5B9E\u63A7\u533A\uFF0C\u8BE5\u533A\u57DF\u5373\u88AB\u6C61\u67D3\u5931\u6548\u3002\u5BF9\u65B9\u8FD8\u62E5\u6709\u66F4\u9AD8\u8010\u4E45\u7684\u201C\u5EFA\u7B51\u8D44\u4EA7\u201D\uFF0C\u6467\u6BC1\u5373\u53EF\u83B7\u5F97\u653B\u575A\u79EF\u5206\uFF0C\u8FD9\u662F\u8FBE\u6210\u80DC\u5229\u76EE\u6807\u7684\u552F\u4E00\u51ED\u8BC1\u3002\r\n\u5982\u679C\u60A8\u6240\u5728\u5730\u533A\u7684\u5B9E\u63A7\u533A\u5931\u5B88\uFF0C\u751A\u81F3\u4E8E\u5168\u90E8\u4E22\u5931\uFF0C\u90A3\u4E48\u975E\u5E38\u62B1\u6B49\uFF0C\u60A8\u53EF\u80FD\u9700\u8981\u4E00\u573A\u989D\u5916\u7684\u4F11\u5047\u3002\r\n\r\n\u56DB\u3001\u6388\u6743\u4F53\u7CFB\r\n\u6388\u6743\u4E2D\u5FC3\u4F1A\u6301\u7EED\u4EA7\u51FA\u79EF\u5206\uFF0C\u7D2F\u8BA1\u8FBE\u5230\u5F53\u524D\u9636\u6BB5\u8981\u6C42\u540E\uFF0C\u60A8\u53EF\u4EE5\u7533\u8BF7\u65B0\u7684\u5355\u4F4D\u90E8\u7F72\u8D44\u683C\uFF0C\u5355\u4F4D\u90E8\u7F72\u8D44\u683C\u7684\u7533\u8BF7\u662F\u5206\u9636\u6BB5\u7684\uFF0C\u6BCF\u9636\u6BB5\u5C06\u63D0\u4F9B\u591A\u4E2A\u9009\u9879\uFF0C\u8BF7\u6839\u636E\u6218\u51B5\u7075\u6D3B\u9009\u62E9\uFF0C\u4EE5\u5E94\u5BF9\u65E5\u76CA\u590D\u6742\u7684\u5E02\u573A\u73AF\u5883\u3002\r\n\r\n\u518D\u6B21\u5F3A\u8C03\uFF0C\u60A8\u7684\u6BCF\u4E00\u4E2A\u51B3\u7B56\uFF0C\u90FD\u5728\u5B9A\u4E49\u8FD9\u7247\u533A\u57DF\u7684\u672A\u6765\u3002\r\n\u795D\uFF0C\u4E1A\u52A1\u987A\u5229\u3002\r\n\r\n\u4E94\u516C\u53F8\u6218\u7565\u6295\u8D44\u90E8
    \u5E02\u573A\u5F00\u62D3\u7EC4"
