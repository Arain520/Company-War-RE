  - levelId: L20
    title: "\u7EC8\u5C40"
    shortDescription: "\u6700\u540E\u7684\u6218\u573A\u5DF2\u7ECF\u8D85\u8D8A\u7ECF\u9A8C\u8303\u7574\uFF0C\u6211\u4EEC\u77E5\u9053\u4E86\u4EFB\u52A1\u6307\u6807\uFF0C\u4E5F\u77E5\u9053\u5168\u90E8\u5B8C\u6210\u610F\u5473\u7740\u4EC0\u4E48\u3002"
    recordText: "\u6700\u540E\u7684\u6218\u573A\u662F\u4E00\u5E45\u8D85\u8D8A\u7ECF\u9A8C\u8303\u7574\u7684\u56FE\u666F\u3002\u76AE\u5C42\u5982\u82D4\u85D3\u822C\u8986\u76D6\u4E86\u6BCF\u4E00\u5BF8\u53EF\u8FA8\u8BC6\u7684\u5730\u9762\uFF0C\u6076\u9B54\u7684\u4F4E\u8BED\u4ECE\u653B\u52BF\u542F\u52A8\u7684\u7B2C\u4E00\u79D2\u5C31\u4E00\u76F4\u5728\u901A\u8BAF\u80CC\u666F\u91CC\u6C99\u6C99\u4F5C\u54CD\u3002\u5DE8\u517D\u5728\u6B63\u9762\u541E\u98DF\u6211\u4EEC\u7684\u706B\u529B\u7EBF\uFF0C\u4E09\u5EA7\u672F\u5E08\u5728\u540C\u6B65\u5012\u6570\uFF0C\u65F6\u95F4\u4E00\u5230\uFF0C\u4EBA\u5C31\u5012\u4E0B\uFF0C\u5E72\u8106\u5229\u843D\uFF0C\u50CF\u88AB\u637B\u65AD\u4E86\u706F\u4E1D\u3002\u6211\u4EEC\u77E5\u9053\u4E86\u4EFB\u52A1\u6307\u6807\uFF0C\u4E5F\u77E5\u9053\u5168\u90E8\u5B8C\u6210\u610F\u5473\u7740\u4EC0\u4E48\u3002\u90A3\u662F\u6240\u6709\u7684\u9635\u4EA1\u8C03\u52A8\u5355\u52A0\u5728\u4E00\u8D77\uFF0C\u6362\u4E00\u4EFD\u88AB\u76D6\u7AE0\u7684\u786E\u8BA4\u51FD\u3002\u4E3B\u7BA1\uFF0C\u8FD9\u4E0D\u662F\u4E3A\u516C\u53F8\u800C\u6218\u3002\u8FD9\u662F\u4E3A\u4E86\u786E\u8BA4\u2014\u2014\u5728\u8FD9\u4E00\u5207\u7ED3\u675F\u4E4B\u540E\uFF0C\u6211\u4EEC\u8FD8\u80FD\u4E0D\u80FD\u88AB\u79F0\u4F5C\u4EBA\u3002"
