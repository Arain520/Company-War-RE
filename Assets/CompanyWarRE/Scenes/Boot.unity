    recordText: "\u6076\u9B54\u3001\u5DE8\u517D\u3001\u672F\u5E08\u3002\u4E09\u4E2A\u540D\u79F0\u7B2C\u4E00\u6B21\u540C\u65F6\u51FA\u73B0\u5728\u540C\u4E00\u4EFD\u4EFB\u52A1\u6587\u4EF6\u4E0A\uFF0C\u6253\u5B57\u673A\u5728\u6253\u8FD9\u4E09\u4E2A\u8BCD\u7684\u65F6\u5019\uFF0C\u58A8\u6C34\u6E17\u900F\u4E86\u7EB8\u80CC\u3002\u6076\u9B54\u4ECE\u8FDC\u5904\u4FB5\u8680\uFF0C\u5DE8\u517D\u5728\u6B63\u9762\u541E\u566C\uFF0C\u672F\u5E08\u5728\u6700\u540E\u65B9\u4EE5\u4E0D\u53D8\u7684\u901F\u5EA6\u6E05\u70B9\u751F\u547D\u3002\u5341\u4E94\u884C\u7EB5\u6DF1\uFF0C\u6CA1\u6709\u4E00\u4E2A\u4F4D\u7F6E\u662F\u5B89\u5168\u7684\u3002\u5173\u4E8E\u8FD9\u6B21\u884C\u52A8\u7684\u8BB0\u5F55\u6781\u5176\u7A00\u5C11\u3002\u552F\u4E00\u7559\u5B58\u4E0B\u6765\u7684\u4E00\u53E5\u8BDD\u6765\u81EA\u5E78\u5B58\u8005\u7684\u53E3\u8FF0\uFF1A\u201C\u5B83\u4EEC\u5728\u5206\u5DE5\u5408\u4F5C\u3002\u5C31\u50CF\u2014\u2014\u4E00\u4E2A\u8EAB\u4F53\u3002\u201D"
