  - levelId: L18
    title: "\u4EEA\u5F0F\u6027\u9632\u5FA1"
    shortDescription: "\u672F\u5E08\u7684\u6570\u91CF\u589E\u52A0\u5230\u4E86\u4E09\u540D\uFF0C\u81F4\u6B7B\u5468\u671F\u540C\u6B65\u8FD0\u8F6C\uFF0C\u50CF\u67D0\u79CD\u4E0D\u613F\u88AB\u6253\u65AD\u7684\u4EEA\u5F0F\u3002"
    recordText: "\u4E0D\u662F\u4E00\u4E2A\u3002\u662F\u4E09\u4E2A\u3002\u672F\u5E08\u7684\u6570\u91CF\u589E\u52A0\u5230\u4E86\u4E09\u540D\uFF0C\u5206\u522B\u5360\u636E\u7EB5\u6DF1\u5C3D\u5934\u7684\u4E09\u4E2A\u4F4D\u7F6E\u3002\u5B83\u4EEC\u7684\u81F4\u6B7B\u5468\u671F\u540C\u6B65\u8FD0\u8F6C\uFF0C\u50CF\u67D0\u79CD\u7CBE\u786E\u7684\u3001\u4E0D\u613F\u88AB\u6253\u65AD\u7684\u4EEA\u5F0F\u3002\u524D\u7EBF\u90E8\u961F\u5FC5\u987B\u5728\u5012\u8BA1\u65F6\u95F4\u9699\u4E2D\u6467\u6BC1\u8DB3\u591F\u591A\u7684\u5DE2\u7A74\u548C\u76AE\u5C42\uFF0C\u624D\u80FD\u6253\u5F00\u901A\u5F80\u5176\u4E2D\u4EFB\u4F55\u4E00\u4E2A\u7684\u8DEF\u5F84\u3002\u6218\u672F\u5206\u6790\u4F1A\u4E0A\uFF0C\u4E00\u4F4D\u8D44\u6DF1\u987E\u95EE\u5728\u6C89\u9ED8\u4E86\u5F88\u4E45\u4E4B\u540E\u8BF4\uFF1A\u201C\u8FD9\u662F\u67D0\u79CD\u4EEA\u5F0F\u6027\u9632\u5FA1\u3002\u5B83\u4EEC\u4E0D\u662F\u5728\u5B88\u536B\u4EC0\u4E48\u3002\u5B83\u4EEC\u662F\u5728\u7B49\u5F85\u4EC0\u4E48\u3002\u201D"
    chapterName: "\u6DF1\u5C42\u6863\u6848\u9636\u6BB5"
