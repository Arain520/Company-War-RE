    recordText: "\u4EFB\u52A1\u7F16\u53F7001\uFF0C\u5730\u70B9\u4E3A\u7B2C\u4E94\u529E\u516C\u533A\u3002\u65B0\u4EBA\u57F9\u8BAD\u7684\u6700\u540E\u4E00\u73AF\uFF0C\u6240\u6709\u9884\u5907\u4E3B\u7BA1\u5FC5\u987B\u5728\u9650\u5B9A\u65F6\u95F4\u5185\u6E05\u9664\u5360\u636E\u8336\u6C34\u95F4\u7684\u201C\u8FDD\u89C4\u6EDE\u7559\u4EBA\u5458\u201D\u3002\u8FD9\u662F\u6807\u51C6\u6D41\u7A0B\uFF0C\u4E0A\u7EA7\u4E0D\u4F1A\u63D0\u4F9B\u8D85\u51FA\u57FA\u51C6\u7EBF\u7684\u652F\u63F4\u3002\u62A5\u544A\u4E2D\u7279\u522B\u6CE8\u660E\uFF1A\u8FD9\u4E9B\u76EE\u6807\u7684\u884C\u4E3A\u6A21\u5F0F\u201C\u673A\u68B0\u4E14\u91CD\u590D\u201D\uFF0C\u4E0D\u5177\u5907\u8C08\u5224\u53EF\u80FD\u3002\u4EFB\u52A1\u7ED3\u675F\u65F6\u63D0\u4EA4\u4E00\u4EFD\u884C\u52A8\u62A5\u544A\uFF0C\u4F5C\u4E3A\u6B63\u5F0F\u5165\u804C\u7684\u51ED\u8BC1\u3002\u81F3\u4ECA\u4E3A\u6B62\uFF0C\u6240\u6709\u901A\u8FC7\u8003\u6838\u7684\u4E3B\u7BA1\u90FD\u62D2\u7EDD\u8C08\u8BBA\u4ED6\u4EEC\u5728\u8336\u6C34\u95F4\u91CC\u770B\u5230\u7684\u5177\u4F53\u7EC6\u8282\u3002"
